# Optional canonical origin. Must match the invitation URL if provided.
NEXT_PUBLIC_BASE_URL=
# Optional override of the confirmed WhatsApp number, international digits only.
NEXT_PUBLIC_HOST_WHATSAPP=

# FormSubmit already defaults to the confirmed client inbox on the server.
# No API key, Resend account, Supabase project or owned sender domain is needed.
# Optional recipient override. Changing it requires activating that new inbox.
FORMSUBMIT_RECIPIENT=
