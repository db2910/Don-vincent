# Canonical public origin. Match this to the browser origin (no trailing slash required).
NEXT_PUBLIC_BASE_URL=
# Optional: international digits only, without +, to enable the host WhatsApp link.
NEXT_PUBLIC_HOST_WHATSAPP=

# Server-only: never prefix these with NEXT_PUBLIC_. Apply the migration first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a long random secret, for example: openssl rand -hex 32
RSVP_RATE_LIMIT_SECRET=

# Optional host notifications. Use a verified Resend sender; recipient addresses
# may be comma-separated. Missing values leave the private notification queued.
RESEND_API_KEY=
RSVP_NOTIFICATION_FROM=
RSVP_NOTIFICATION_TO=
RSVP_NOTIFICATION_RETRY_SECRET=

# Missing database configuration in local development returns an honest preview.
# Production always returns 503 until the database and rate-limit secret are set.
